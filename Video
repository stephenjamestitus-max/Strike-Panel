<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>StrikePanel™ — Product Demo</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#070a12;--accent:#00D4F0;--green:#10b981;--red:#ef4444;--amber:#f59e0b;--purple:#8b5cf6;
  --text:#eef0f8;--muted:#7a85a0;--muted2:#3a4558;
  --fh:'Bebas Neue',sans-serif;--fc:'Barlow Condensed',sans-serif;--fb:'Barlow',sans-serif;--fm:'DM Mono',monospace;
}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg)}

/* ── AMBIENT BG ── */
.ambient{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(ellipse 70% 60% at 15% 20%,rgba(0,212,240,0.07) 0%,transparent 55%),
             radial-gradient(ellipse 50% 40% at 85% 80%,rgba(139,92,246,0.06) 0%,transparent 55%),
             radial-gradient(ellipse 40% 35% at 50% 50%,rgba(239,68,68,0.02) 0%,transparent 55%);
}
.noise{position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  background-size:180px;opacity:0.4;
}

/* ── SLIDE SYSTEM ── */
#stage{position:fixed;inset:0;z-index:1;display:flex;align-items:center;justify-content:center}
.slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:0;
  opacity:0;transform:scale(0.97);
  transition:opacity 0.7s cubic-bezier(0.23,1,0.32,1),transform 0.7s cubic-bezier(0.23,1,0.32,1);
  pointer-events:none;
}
.slide.active{opacity:1;transform:scale(1);pointer-events:auto}
.slide.exit{opacity:0;transform:scale(1.02);}

/* ── PROGRESS BAR ── */
#progress-bar{position:fixed;top:0;left:0;right:0;height:3px;z-index:100;background:rgba(255,255,255,0.05)}
#progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),rgba(139,92,246,0.8));
  width:0%;transition:width 0.1s linear;box-shadow:0 0 8px rgba(0,212,240,0.5)}

/* ── SLIDE DOTS ── */
#dots{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:100;
  display:flex;gap:8px;align-items:center}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.18);
  transition:all 0.3s;cursor:pointer}
.dot.active{width:24px;border-radius:3px;background:var(--accent);box-shadow:0 0 8px rgba(0,212,240,0.5)}

/* ── SLIDE COUNTER ── */
#counter{position:fixed;bottom:28px;right:32px;z-index:100;
  font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:2px;
  text-transform:uppercase;color:var(--muted2)}

/* ── SKIP / REPLAY ── */
#controls{position:fixed;bottom:24px;left:32px;z-index:100;display:flex;gap:8px}
.ctrl-btn{font-family:var(--fc);font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  padding:6px 14px;border-radius:20px;border:1px solid rgba(255,255,255,0.1);
  background:rgba(255,255,255,0.04);color:var(--muted);cursor:pointer;transition:all .2s}
.ctrl-btn:hover{border-color:rgba(0,212,240,0.3);color:var(--accent)}

/* ── LOGO ── */
.sp-logo{display:flex;align-items:center;gap:10px}
.sp-logo-name{font-family:var(--fh);font-size:22px;letter-spacing:3px;color:var(--text)}
.sp-logo-name span{color:var(--accent)}

/* ── DEVICE FRAMES ── */
.laptop-frame{position:relative}
.laptop-screen{background:#0d1018;border:1.5px solid rgba(255,255,255,0.12);border-radius:14px 14px 0 0;padding:9px 9px 0}
.laptop-screen-inner{border-radius:7px 7px 0 0;overflow:hidden;border:1px solid rgba(255,255,255,0.07);border-bottom:none;line-height:0}
.laptop-screen-inner img{width:100%;display:block}
.laptop-chin{background:linear-gradient(180deg,#12161e,#0c1016);height:14px;border-radius:0 0 4px 4px;border:1.5px solid rgba(255,255,255,0.08);border-top:none}
.laptop-base{background:#090d14;height:8px;border-radius:0 0 20px 20px;border:1px solid rgba(255,255,255,0.04);border-top:none;width:52%;margin:0 auto}
.laptop-cam{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,0.07);margin:0 auto 7px}
.laptop-glow{position:absolute;bottom:-24px;left:10%;right:10%;height:30px;filter:blur(18px);pointer-events:none}

.phone-frame{background:linear-gradient(180deg,#1c1f2e,#0f1118);border:2px solid rgba(255,255,255,0.15);
  border-radius:44px;padding:14px 10px 20px;position:relative;
  box-shadow:0 32px 90px rgba(0,0,0,0.9),0 0 0 1px rgba(255,255,255,0.03)}
.phone-notch{width:72px;height:6px;background:#0a0c14;border-radius:3px;margin:0 auto 10px;border:1px solid rgba(255,255,255,0.07)}
.phone-screen{border-radius:28px;overflow:hidden;line-height:0;border:1px solid rgba(255,255,255,0.06)}
.phone-screen img{width:100%;display:block}
.phone-home-bar{width:48px;height:4px;background:rgba(255,255,255,0.12);border-radius:2px;margin:10px auto 0}
.phone-btn-l{position:absolute;left:-3px;top:82px;width:3px;height:28px;background:rgba(255,255,255,0.12);border-radius:2px 0 0 2px}
.phone-btn-l2{position:absolute;left:-3px;top:120px;width:3px;height:50px;background:rgba(255,255,255,0.12);border-radius:2px 0 0 2px}
.phone-btn-r{position:absolute;right:-3px;top:100px;width:3px;height:60px;background:rgba(255,255,255,0.12);border-radius:0 2px 2px 0}

/* ── COPY ELEMENTS ── */
.slide-copy{max-width:540px;text-align:left}
.eyebrow{font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;
  margin-bottom:14px;display:inline-flex;align-items:center;gap:8px;
  padding:5px 16px;border-radius:20px}
.eyebrow.cyan{color:var(--accent);background:rgba(0,212,240,0.08);border:1px solid rgba(0,212,240,0.2)}
.eyebrow.red{color:var(--red);background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2)}
.eyebrow.green{color:var(--green);background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2)}
.eyebrow.purple{color:#a78bfa;background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.2)}
.eyebrow.amber{color:var(--amber);background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2)}
.slide-title{font-family:var(--fh);font-size:clamp(36px,5.5vw,64px);letter-spacing:3px;line-height:0.95;margin-bottom:16px}
.slide-title .accent{color:var(--accent)}
.slide-title .red{color:var(--red)}
.slide-title .green{color:var(--green)}
.slide-title .dim{color:rgba(238,240,248,0.22)}
.slide-sub{font-size:clamp(13px,1.5vw,16px);color:var(--muted);line-height:1.8;margin-bottom:22px}
.slide-sub strong{color:var(--text)}
.stat-row{display:flex;gap:20px;flex-wrap:wrap;margin-top:10px}
.stat{text-align:left}
.stat-val{font-family:var(--fh);font-size:38px;letter-spacing:2px;line-height:1}
.stat-lbl{font-family:var(--fc);font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin-top:2px}
.check-list{list-style:none;display:flex;flex-direction:column;gap:9px;margin-top:4px}
.check-list li{font-size:14px;color:var(--muted);display:flex;align-items:flex-start;gap:9px;line-height:1.5}
.check-list li::before{content:'✓';color:var(--green);font-weight:700;flex-shrink:0;margin-top:1px}
.check-list li strong{color:var(--text)}
.price-badge{display:inline-flex;align-items:center;gap:12px;background:rgba(0,0,0,0.3);
  border:1px solid rgba(0,212,240,0.2);border-radius:14px;padding:12px 20px;margin-top:16px}
.price-big{font-family:var(--fh);font-size:52px;color:var(--text);letter-spacing:2px;line-height:1}
.price-detail .once{font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--green)}
.price-detail .never{font-family:var(--fc);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin-top:2px}

/* ── SLIDE LAYOUTS ── */
.layout-hero{flex-direction:column;text-align:center;padding:60px 40px 80px}
.layout-split{gap:clamp(24px,4vw,64px);padding:40px clamp(24px,5vw,80px) 80px;max-width:1300px;width:100%}
.layout-center{flex-direction:column;padding:40px 40px 80px;max-width:960px;width:100%}
.layout-fullscreen{padding:20px 20px 80px;max-width:1100px;width:100%}

/* Pulse dot */
.pdot{width:8px;height:8px;border-radius:50%;display:inline-block;animation:pdot 2s ease-in-out infinite}
@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.6)}}

/* Scan line animation on screens */
@keyframes scan{0%{transform:translateY(-100%)}100%{transform:translateY(200%)}}
.scan-line{position:absolute;inset:0;overflow:hidden;pointer-events:none;border-radius:inherit}
.scan-line::after{content:'';position:absolute;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,rgba(0,212,240,0.15),transparent);
  animation:scan 3s linear infinite;}

/* Type-on for hero */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.fade-up{animation:fadeUp 0.6s cubic-bezier(0.23,1,0.32,1) both}
.fd1{animation-delay:.1s}.fd2{animation-delay:.25s}.fd3{animation-delay:.4s}.fd4{animation-delay:.55s}.fd5{animation-delay:.7s}.fd6{animation-delay:.85s}

/* Gumroad CTA pill */
.gum-cta{display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,var(--accent),#009ab0);
  color:#050810;font-family:var(--fc);font-size:13px;font-weight:800;letter-spacing:2px;text-transform:uppercase;
  padding:14px 30px;border-radius:30px;text-decoration:none;
  box-shadow:0 0 30px rgba(0,212,240,0.4),0 4px 20px rgba(0,0,0,0.3);
  transition:all .2s;margin-top:20px;}
.gum-cta:hover{box-shadow:0 0 50px rgba(0,212,240,0.65);transform:translateY(-2px)}

</style>
</head>
<body>
<div class="ambient"></div>
<div class="noise"></div>
<div id="progress-bar"><div id="progress-fill"></div></div>

<div id="stage">

  <!-- ══════════════════════════════════════════
       SLIDE 1 — HERO / PROBLEM STATEMENT
  ══════════════════════════════════════════ -->
  <div class="slide layout-hero active" id="s1">
    <div class="fade-up fd1" style="margin-bottom:20px">
      <svg width="72" height="72" viewBox="0 0 90 90" xmlns="http://www.w3.org/2000/svg">
        <defs><radialGradient id="hg" cx="38%" cy="32%" r="62%"><stop offset="0%" stop-color="#1e2540"/><stop offset="55%" stop-color="#0f1220"/><stop offset="100%" stop-color="#0b0d14"/></radialGradient></defs>
        <circle cx="45" cy="45" r="43" fill="url(#hg)" stroke="#00D4F0" stroke-width="1.5" stroke-opacity="0.7"/>
        <circle cx="45" cy="45" r="29" fill="none" stroke="#00D4F0" stroke-width="1" stroke-opacity="0.2"/>
        <line x1="45" y1="2" x2="45" y2="26" stroke="#00D4F0" stroke-width="2.8" stroke-linecap="round"/>
        <line x1="45" y1="64" x2="45" y2="88" stroke="#00D4F0" stroke-width="2.8" stroke-linecap="round"/>
        <line x1="2" y1="45" x2="26" y2="45" stroke="#00D4F0" stroke-width="2.8" stroke-linecap="round"/>
        <line x1="64" y1="45" x2="88" y2="45" stroke="#00D4F0" stroke-width="2.8" stroke-linecap="round"/>
        <circle cx="45" cy="45" r="11" fill="#00D4F0"/>
        <text x="45" y="49" font-family="Arial Black,sans-serif" font-size="8" font-weight="900" fill="#050e1a" text-anchor="middle">SP</text>
      </svg>
    </div>
    <div class="fade-up fd2" style="font-family:var(--fh);font-size:clamp(16px,2vw,20px);letter-spacing:4px;color:var(--muted);margin-bottom:10px">STRIKEPANEL™ · TRAINING INTELLIGENCE</div>
    <div class="fade-up fd3" style="font-family:var(--fh);font-size:clamp(52px,9vw,110px);letter-spacing:3px;line-height:0.88;margin-bottom:24px;text-align:center">
      <div style="color:rgba(238,240,248,0.22)">STOP</div>
      <div style="color:var(--accent)">GUESSING.</div>
      <div style="color:rgba(238,240,248,0.22)">START</div>
      <div style="color:var(--red)">KNOWING.</div>
    </div>
    <div class="fade-up fd4" style="font-size:clamp(14px,1.8vw,18px);color:var(--muted);max-width:580px;line-height:1.8;margin-bottom:28px">
      Who's fresh enough to spar? Who's carrying fatigue?<br>
      <strong style="color:var(--text)">You shouldn't have to guess. Now you don't.</strong>
    </div>
    <div class="fade-up fd5" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
      <span style="font-family:var(--fc);font-size:10px;font-weight:700;letter-spacing:2px;padding:5px 13px;border-radius:20px;background:rgba(0,212,240,0.07);border:1px solid rgba(0,212,240,0.18);color:var(--accent)">🥊 Combat Sports</span>
      <span style="font-family:var(--fc);font-size:10px;font-weight:700;letter-spacing:2px;padding:5px 13px;border-radius:20px;background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.18);color:var(--green)">🏋️ Gym &amp; Fitness</span>
      <span style="font-family:var(--fc);font-size:10px;font-weight:700;letter-spacing:2px;padding:5px 13px;border-radius:20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--muted)">👥 Fight Teams</span>
      <span style="font-family:var(--fc);font-size:10px;font-weight:700;letter-spacing:2px;padding:5px 13px;border-radius:20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:var(--muted)">💪 Solo Athletes</span>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       SLIDE 2 — HOME DASHBOARD
  ══════════════════════════════════════════ -->
  <div class="slide layout-split" id="s2">
    <div class="slide-copy fade-up fd1" style="flex-shrink:0;max-width:400px">
      <div class="eyebrow cyan"><span class="pdot" style="background:var(--accent);box-shadow:0 0 8px var(--accent)"></span>The Dashboard</div>
      <div class="slide-title">Everything.<br><span class="accent">At a glance.</span></div>
      <div class="slide-sub">Open StrikePanel every morning and your entire squad is right there — readiness status, upcoming fights, sessions logged. <strong>No digging. No spreadsheets.</strong></div>
      <div class="stat-row">
        <div class="stat"><div class="stat-val" style="color:var(--accent)">3</div><div class="stat-lbl">Athletes</div></div>
        <div class="stat"><div class="stat-val" style="color:var(--green)">60/100</div><div class="stat-lbl">Avg Readiness</div></div>
        <div class="stat"><div class="stat-val" style="color:var(--text)">4</div><div class="stat-lbl">Check-ins today</div></div>
      </div>
    </div>
    <div class="laptop-frame fade-up fd2" style="flex:1;min-width:0;max-width:700px">
      <div class="laptop-screen">
        <div class="laptop-cam"></div>
        <div class="laptop-screen-inner" style="position:relative">
          <img src="data:image/png;base64," alt="StrikePanel Home"/>
          <div class="scan-line"></div>
        </div>
      </div>
      <div class="laptop-chin"></div>
      <div class="laptop-base"></div>
      <div class="laptop-glow" style="background:rgba(0,212,240,0.07)"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       SLIDE 3 — MORNING BRIEF (THE USP)
  ══════════════════════════════════════════ -->
  <div class="slide layout-split" id="s3">
    <div class="slide-copy fade-up fd1" style="flex-shrink:0;max-width:400px">
      <div class="eyebrow cyan"><span class="pdot" style="background:var(--accent);box-shadow:0 0 8px var(--accent)"></span>The Core Feature</div>
      <div class="slide-title">Who to push.<br><span class="red">Who to protect.</span></div>
      <div class="slide-sub">Every morning. Every athlete. A <strong>0–100 readiness score</strong> calculated from sleep, energy, soreness, motivation, nutrition and pain. Green means go. Red means protect.</div>
      <ul class="check-list">
        <li><strong>Tyler Novak — REST TODAY (38/100)</strong> — Knee pain flagged</li>
        <li><strong>Priya Sharma — PUSH HARD (70/100)</strong> — Trending up</li>
        <li><strong>Marcus Okafor — TRAIN NORMAL (72/100)</strong> — Consistent</li>
      </ul>
    </div>
    <div class="laptop-frame fade-up fd2" style="flex:1;min-width:0;max-width:700px">
      <div class="laptop-screen">
        <div class="laptop-cam"></div>
        <div class="laptop-screen-inner" style="position:relative">
          <img src="data:image/png;base64," alt="Morning Brief"/>
          <div class="scan-line"></div>
        </div>
      </div>
      <div class="laptop-chin"></div>
      <div class="laptop-base"></div>
      <div class="laptop-glow" style="background:rgba(16,185,129,0.06)"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       SLIDE 4 — CHECK-IN FLOW EXPLAINER
  ══════════════════════════════════════════ -->
  <div class="slide layout-center" id="s4" style="flex-direction:column;align-items:center">
    <div style="text-align:center;margin-bottom:40px" class="fade-up fd1">
      <div class="eyebrow cyan" style="display:inline-flex"><span class="pdot" style="background:var(--accent);box-shadow:0 0 8px var(--accent)"></span>How athletes check in</div>
      <div class="slide-title" style="text-align:center">30 seconds.<br><span class="accent">Any phone.</span><br><span class="dim">No app.</span></div>
      <div class="slide-sub" style="max-width:520px;margin:0 auto">You share one WhatsApp link. Athletes open it — no download, no account. 6 sliders. Submit. Score appears in your Morning Brief instantly.</div>
    </div>
    <div class="fade-up fd2" style="display:flex;gap:32px;align-items:center;justify-content:center;flex-wrap:wrap">
      <!-- Step 1 -->
      <div style="text-align:center;max-width:180px">
        <div style="width:52px;height:52px;border-radius:50%;background:rgba(0,212,240,0.1);border:1px solid rgba(0,212,240,0.25);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-family:var(--fh);font-size:24px;color:var(--accent)">1</div>
        <div style="font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text);margin-bottom:6px">Coach shares link</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Copy from Morning Brief. Send once on WhatsApp.</div>
      </div>
      <div style="font-size:28px;color:rgba(0,212,240,0.3);font-family:var(--fh)">→</div>
      <!-- Step 2 -->
      <div style="text-align:center;max-width:180px">
        <div style="width:52px;height:52px;border-radius:50%;background:rgba(0,212,240,0.1);border:1px solid rgba(0,212,240,0.25);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-family:var(--fh);font-size:24px;color:var(--accent)">2</div>
        <div style="font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text);margin-bottom:6px">Athlete submits</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Opens link on their phone. 6 sliders. Done in 30 seconds.</div>
      </div>
      <div style="font-size:28px;color:rgba(0,212,240,0.3);font-family:var(--fh)">→</div>
      <!-- Step 3 -->
      <div style="text-align:center;max-width:180px">
        <div style="width:52px;height:52px;border-radius:50%;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-family:var(--fh);font-size:24px;color:var(--green)">3</div>
        <div style="font-family:var(--fc);font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text);margin-bottom:6px">Your brief updates</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Score syncs instantly. Before training starts, you know.</div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════
       SLIDE 5 — FIGHT DATES (PHONE MOCKUP)
  ══════════════════════════════════════════ -->
  <div class="slide layout-split" id="s5">
    <div class="phone-frame fade-up fd1" style="width:240px;flex-shrink:0">
      <div class="phone-btn-l"></div><div class="phone-btn-l2"></div><div class="phone-btn-r"></div>
      <div class="phone-notch"></div>
