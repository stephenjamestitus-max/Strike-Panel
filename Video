<!-- Navigation dots -->
<div id="dots"></div>
<div id="counter"></div>
<div id="controls">
  <button class="ctrl-btn" onclick="prevSlide()">← Prev</button>
  <button class="ctrl-btn" id="pauseBtn" onclick="togglePause()">⏸ Pause</button>
  <button class="ctrl-btn" onclick="goToSlide(0)">↺ Restart</button>
</div>

<script>
const SLIDES = document.querySelectorAll('.slide');
const N = SLIDES.length;
const DURATIONS = [5000, 6000, 6000, 7000, 6000, 6000, 6000, 6000, 6500, 9000]; // ms per slide
let current = 0, paused = false, timer = null, startTime = null, elapsed = 0;

const fill = document.getElementById('progress-fill');
const counter = document.getElementById('counter');
const pauseBtn = document.getElementById('pauseBtn');

// Build dots
const dotsEl = document.getElementById('dots');
for(let i=0;i<N;i++){
  const d = document.createElement('div');
  d.className = 'dot' + (i===0?' active':'');
  d.onclick = ()=>goToSlide(i);
  dotsEl.appendChild(d);
}

function updateDots(){
  document.querySelectorAll('.dot').forEach((d,i)=>{
    d.className = 'dot' + (i===current?' active':'');
  });
  counter.textContent = (current+1) + ' / ' + N;
}

function showSlide(idx){
  SLIDES[current].classList.remove('active');
  SLIDES[current].classList.add('exit');
  setTimeout(()=>SLIDES[current].classList.remove('exit'), 700);
  current = (idx + N) % N;
  SLIDES[current].classList.add('active');
  // Re-trigger fade-up animations
  SLIDES[current].querySelectorAll('.fade-up').forEach(el=>{
    el.style.animation='none';
    el.offsetHeight; // reflow
    el.style.animation='';
  });
  updateDots();
  elapsed = 0;
  startTime = performance.now();
  fill.style.width = '0%';
}

function goToSlide(idx){ clearTimeout(timer); showSlide(idx); if(!paused) scheduleNext(); }
function nextSlide(){ showSlide(current+1); if(!paused) scheduleNext(); }
function prevSlide(){ clearTimeout(timer); showSlide(current-1); if(!paused) scheduleNext(); }

function scheduleNext(){
  clearTimeout(timer);
  startTime = performance.now();
  const dur = DURATIONS[current];
  timer = setTimeout(nextSlide, dur - elapsed);
  requestAnimationFrame(animateBar);
}

function animateBar(now){
  if(paused) return;
  const dur = DURATIONS[current];
  const pct = Math.min(((now - startTime + elapsed) / dur) * 100, 100);
  fill.style.width = pct + '%';
  if(pct < 100) requestAnimationFrame(animateBar);
}

function togglePause(){
  paused = !paused;
  pauseBtn.textContent = paused ? '▶ Play' : '⏸ Pause';
  if(paused){
    clearTimeout(timer);
    elapsed += performance.now() - startTime;
  } else {
    startTime = performance.now();
    scheduleNext();
    requestAnimationFrame(animateBar);
  }
}

// Keyboard nav
document.addEventListener('keydown', e=>{
  if(e.key==='ArrowRight'||e.key===' ') goToSlide(current+1);
  if(e.key==='ArrowLeft') prevSlide();
  if(e.key==='p'||e.key==='P') togglePause();
});

// Init
updateDots();
scheduleNext();
</script>
