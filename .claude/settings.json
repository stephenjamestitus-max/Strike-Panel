{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "zernio": {
      "command": "npx",
      "args": ["-y", "@zernio/mcp-server"],
      "env": {
        "ZERNIO_API_KEY": "${ZERNIO_API_KEY}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(node*)",
      "Bash(npx*)",
      "Bash(git*)",
      "Bash(cat*)",
      "Bash(ls*)"
    ]
  }
}
